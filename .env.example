# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
HASHID_SALT=change-me-to-another-random-string
DATABASE_URL=mysql+mysqlconnector://user:password@localhost/pdc_manager
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# Used only once, when the first admin user is created in an empty database
ADMIN_SEED_PASSWORD=change-me-first-login

# Oracle ERP R12.2.10 (optional - leave empty to disable ERP sync)
ERP_DB_HOST=
ERP_DB_PORT=1521
ERP_DB_SERVICE=
ERP_DB_USERNAME=
ERP_DB_PASSWORD=
ERP_INSTANT_CLIENT=C:\oracle\instantclient
